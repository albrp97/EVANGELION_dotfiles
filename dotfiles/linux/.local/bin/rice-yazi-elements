#!/usr/bin/env bash
set -euo pipefail

device="/dev/disk/by-uuid/36D69E09D69DC98F"

if [[ ! -e "$device" ]]; then
  echo "rice-yazi-elements: Elements HDD is not available: $device" >&2
  exit 1
fi

if ! command -v udisksctl >/dev/null 2>&1; then
  echo "rice-yazi-elements: udisksctl is required to mount the Elements HDD" >&2
  exit 1
fi

mountpoint="$(findmnt -rn -S "$device" -o TARGET || true)"
if [[ -z "$mountpoint" ]]; then
  udisksctl mount -b "$device" >/dev/null
  mountpoint="$(findmnt -rn -S "$device" -o TARGET || true)"
fi

if [[ -z "$mountpoint" ]]; then
  echo "rice-yazi-elements: the Elements HDD could not be mounted" >&2
  exit 1
fi

exec ya emit cd "$mountpoint"
