QWidget {
    color: #F2EAFF;
    selection-background-color: #7C5FB8;
    selection-color: #F7EFFF;
}

QMainWindow,
QDialog,
QDockWidget,
QTabWidget::pane,
QStackedWidget,
QScrollArea,
QAbstractScrollArea {
    background-color: #191724;
    color: #F2EAFF;
}

QWidget#centralWidget,
QWidget#PropertiesWidget,
QWidget#groupBar {
    background-color: #191724;
}

QToolBar {
    background-color: #141218;
    border: none;
    border-bottom: 1px solid #26233A;
    spacing: 4px;
    padding: 4px 6px;
}

QToolBar::separator {
    background-color: #4B3A68;
    width: 1px;
    margin: 4px 5px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 5px;
}

QToolButton:hover {
    background-color: #4B3A68;
    border-color: #7C5FB8;
}

QToolButton:checked,
QToolButton:pressed {
    background-color: #7C5FB8;
    color: #F7EFFF;
}

QToolButton:disabled {
    color: #9A86B8;
}

QMenuBar {
    background-color: #141218;
    border-bottom: 1px solid #26233A;
    spacing: 3px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 5px 8px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #4B3A68;
    color: #F7EFFF;
}

QMenu {
    background-color: #1F1D2E;
    border: 1px solid #4B3A68;
    padding: 4px;
}

QMenu::item {
    padding: 6px 28px 6px 10px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #7C5FB8;
    color: #F7EFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #4B3A68;
    margin: 4px 6px;
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QComboBox {
    background-color: #26233A;
    border: 1px solid #4B3A68;
    border-radius: 4px;
    padding: 4px 6px;
    color: #F2EAFF;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QComboBox:focus {
    border-color: #C4A7E7;
}

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateEdit:disabled,
QTimeEdit:disabled,
QComboBox:disabled {
    color: #9A86B8;
    background-color: #1F1D2E;
}

QComboBox::drop-down {
    width: 24px;
    border: none;
    border-left: 1px solid #4B3A68;
}

QComboBox QAbstractItemView {
    background-color: #1F1D2E;
    border: 1px solid #4B3A68;
    selection-background-color: #7C5FB8;
    selection-color: #F7EFFF;
}

QAbstractItemView,
QTableView,
QTableWidget,
QTreeView,
QTreeWidget,
QListView,
QListWidget,
QColumnView {
    background-color: #191724;
    alternate-background-color: #1F1D2E;
    border: 1px solid #26233A;
    gridline-color: #26233A;
    outline: none;
}

QAbstractItemView::item,
QTableView::item,
QTreeView::item,
QListView::item {
    padding: 4px;
}

QAbstractItemView::item:hover,
QTableView::item:hover,
QTreeView::item:hover,
QListView::item:hover {
    background-color: #2D2944;
}

QAbstractItemView::item:selected,
QTableView::item:selected,
QTreeView::item:selected,
QListView::item:selected {
    background-color: #4B3A68;
    color: #F7EFFF;
}

QHeaderView {
    background-color: #26233A;
}

QHeaderView::section {
    background-color: #26233A;
    color: #C4A7E7;
    border: none;
    border-right: 1px solid #4B3A68;
    border-bottom: 1px solid #4B3A68;
    padding: 5px 6px;
}

QHeaderView::section:hover {
    background-color: #4B3A68;
    color: #F7EFFF;
}

QPushButton {
    background-color: #26233A;
    border: 1px solid #4B3A68;
    border-radius: 5px;
    padding: 5px 12px;
    color: #F2EAFF;
}

QPushButton:hover {
    background-color: #4B3A68;
    border-color: #C4A7E7;
}

QPushButton:pressed,
QPushButton:checked {
    background-color: #7C5FB8;
    border-color: #C4A7E7;
    color: #F7EFFF;
}

QPushButton:default {
    border-color: #A3D977;
}

QPushButton:disabled {
    color: #9A86B8;
    border-color: #26233A;
}

QTabBar::tab {
    background-color: #26233A;
    border: 1px solid #4B3A68;
    border-bottom: none;
    border-radius: 5px 5px 0 0;
    padding: 6px 12px;
    margin-right: 3px;
    color: #9A86B8;
}

QTabBar::tab:hover {
    background-color: #4B3A68;
    color: #F2EAFF;
}

QTabBar::tab:selected {
    background-color: #7C5FB8;
    border-color: #C4A7E7;
    color: #F7EFFF;
}

QGroupBox {
    border: 1px solid #26233A;
    border-radius: 5px;
    margin-top: 10px;
    padding: 10px 6px 6px 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #C4A7E7;
}

QCheckBox,
QRadioButton {
    spacing: 6px;
    color: #E0DEF4;
}

QCheckBox:hover,
QRadioButton:hover {
    color: #F7EFFF;
}

QSlider::groove:horizontal {
    height: 5px;
    background-color: #26233A;
    border: 1px solid #4B3A68;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -5px 0;
    background-color: #C4A7E7;
    border: 1px solid #7C5FB8;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background-color: #7C5FB8;
    border-radius: 3px;
}

QProgressBar {
    background-color: #26233A;
    border: 1px solid #4B3A68;
    border-radius: 4px;
    text-align: center;
    color: #F2EAFF;
}

QProgressBar::chunk {
    background-color: #A3D977;
    border-radius: 3px;
}

QStatusBar {
    background-color: #141218;
    border-top: 1px solid #26233A;
    color: #9A86B8;
}

QStatusBar::item {
    border: none;
}

QDockWidget::title {
    background-color: #26233A;
    border-bottom: 1px solid #4B3A68;
    padding: 5px;
    text-align: left;
}

QSplitter::handle {
    background-color: #26233A;
}

QSplitter::handle:hover {
    background-color: #7C5FB8;
}

QScrollBar:vertical {
    background-color: #191724;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #4B3A68;
    min-height: 28px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #7C5FB8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #191724;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #4B3A68;
    min-width: 28px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #7C5FB8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QToolTip {
    background-color: #26233A;
    border: 1px solid #7C5FB8;
    color: #F7EFFF;
    padding: 4px;
}

QMessageBox {
    background-color: #191724;
}

QLabel[role="heading"] {
    color: #C4A7E7;
}

/*
 * Keep controls opaque while allowing the main EVA surfaces to reveal the
 * compositor background.
 */
QMainWindow {
    background-color: transparent;
}

QDialog,
QDockWidget,
QTabWidget::pane,
QStackedWidget,
QScrollArea,
QAbstractScrollArea,
QMessageBox {
    background-color: rgba(25, 23, 36, 184);
}

QWidget#centralWidget,
QWidget#PropertiesWidget,
QWidget#groupBar {
    background-color: rgba(25, 23, 36, 184);
}

QToolBar,
QMenuBar,
QStatusBar {
    background-color: rgba(20, 18, 24, 224);
}

QMenu,
QComboBox QAbstractItemView {
    background-color: rgba(31, 29, 46, 224);
}

QAbstractItemView,
QTableView,
QTableWidget,
QTreeView,
QTreeWidget,
QListView,
QListWidget,
QColumnView {
    background-color: rgba(25, 23, 36, 184);
    alternate-background-color: rgba(31, 29, 46, 209);
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: rgba(25, 23, 36, 184);
}
