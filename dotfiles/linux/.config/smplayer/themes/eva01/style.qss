/*
 * EVA-01 terminal theme for SMPlayer.
 * Monospace text, hard edges, and status colors give the interface a
 * compact TUI/control-room feel without leaving the EVA palette.
 */

QWidget {
    font-family: "DejaVu Sans Mono", "Liberation Mono", monospace;
    font-size: 10px;
    color: #F2EAFF;
    selection-background-color: #7C5FB8;
    selection-color: #F7EFFF;
}

QMainWindow,
QDialog,
QDockWidget,
QTabWidget::pane,
QStackedWidget,
QScrollArea,
QAbstractScrollArea {
    background-color: #0F1020;
    color: #F2EAFF;
}

MplayerWindow,
MplayerLayer,
#mplayerwindowlogo,
#panel {
    background-color: #050509;
}

QMenuBar,
QToolBar,
EditableToolbar,
AutohideWidget > QToolBar {
    background-color: #0B0A12;
    border: none;
    border-bottom: 1px solid #4B3A68;
}

QMenuBar {
    color: #C4A7E7;
    padding: 1px 2px;
}

QMenuBar::item {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 3px 8px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #1F1D2E;
    border-color: #7C5FB8;
    color: #F7EFFF;
}

QMenu {
    background-color: #0F1020;
    border: 1px solid #7C5FB8;
    color: #F2EAFF;
    padding: 2px;
}

QMenu::item {
    padding: 4px 28px 4px 10px;
}

QMenu::item:selected {
    background-color: #4B3A68;
    color: #F7EFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #4B3A68;
    margin: 3px 5px;
}

QToolBar {
    spacing: 2px;
    padding: 3px 5px;
}

QToolBar::separator,
EditableToolbar::separator {
    background-color: #4B3A68;
    width: 1px;
    margin: 3px 4px;
}

QToolButton,
EditableToolbar > QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 4px;
    color: #C4A7E7;
}

QToolButton:hover,
EditableToolbar > QToolButton:hover {
    background-color: #1F1D2E;
    border-color: #7C5FB8;
    color: #F7EFFF;
}

QToolButton:checked,
QToolButton:pressed,
EditableToolbar > QToolButton:checked,
EditableToolbar > QToolButton:pressed {
    background-color: #4B3A68;
    border-color: #C4A7E7;
    color: #A3D977;
}

QToolButton:disabled,
EditableToolbar > QToolButton:disabled {
    color: #9A86B8;
}

QPushButton {
    background-color: #1F1D2E;
    border: 1px solid #7C5FB8;
    padding: 3px 10px;
    color: #C4A7E7;
}

QPushButton:hover {
    background-color: #4B3A68;
    border-color: #C4A7E7;
    color: #F7EFFF;
}

QPushButton:pressed,
QPushButton:checked {
    background-color: #7C5FB8;
    border-color: #C4A7E7;
    color: #F7EFFF;
}

QPushButton:default {
    border-color: #A3D977;
}

QPushButton:disabled {
    color: #9A86B8;
    border-color: #26233A;
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QComboBox {
    background-color: #0B0A12;
    border: 1px solid #4B3A68;
    padding: 3px 6px;
    color: #F2EAFF;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QComboBox:focus {
    border-color: #C4A7E7;
}

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateEdit:disabled,
QTimeEdit:disabled,
QComboBox:disabled {
    color: #9A86B8;
    background-color: #1F1D2E;
}

QComboBox::drop-down {
    width: 22px;
    border: none;
    border-left: 1px solid #4B3A68;
}

QComboBox QAbstractItemView {
    background-color: #0F1020;
    border: 1px solid #7C5FB8;
    selection-background-color: #4B3A68;
    selection-color: #F7EFFF;
}

QAbstractItemView,
QTableView,
QTableWidget,
QTreeView,
QTreeWidget,
QListView,
QListWidget,
QColumnView {
    background-color: #0F1020;
    alternate-background-color: #141218;
    border: 1px solid #26233A;
    gridline-color: #26233A;
    outline: none;
}

QAbstractItemView::item,
QTableView::item,
QTreeView::item,
QListView::item {
    padding: 3px;
}

QAbstractItemView::item:hover,
QTableView::item:hover,
QTreeView::item:hover,
QListView::item:hover {
    background-color: #1F1D2E;
}

QAbstractItemView::item:selected,
QTableView::item:selected,
QTreeView::item:selected,
QListView::item:selected {
    background-color: #4B3A68;
    color: #F7EFFF;
}

QHeaderView,
QHeaderView::section {
    background-color: #141218;
    color: #A3D977;
}

QHeaderView::section {
    border: none;
    border-right: 1px solid #4B3A68;
    border-bottom: 1px solid #4B3A68;
    padding: 4px 6px;
}

QHeaderView::section:hover {
    background-color: #1F1D2E;
    color: #C4A7E7;
}

QGroupBox {
    border: 1px dashed #4B3A68;
    margin-top: 10px;
    padding: 9px 6px 6px 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #A3D977;
    background-color: #0F1020;
}

QCheckBox,
QRadioButton {
    spacing: 6px;
    color: #E0DEF4;
}

QCheckBox:hover,
QRadioButton:hover {
    color: #F7EFFF;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 11px;
    height: 11px;
    background-color: #0B0A12;
    border: 1px solid #7C5FB8;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #A3D977;
    border-color: #C4A7E7;
}

QSlider::groove:horizontal {
    height: 3px;
    background-color: #26233A;
    border: 1px solid #4B3A68;
}

QSlider::handle:horizontal {
    width: 10px;
    height: 10px;
    margin: -5px 0;
    background-color: #C4A7E7;
    border: 1px solid #7C5FB8;
}

QSlider::sub-page:horizontal {
    background-color: #7C5FB8;
}

QSlider::add-page:horizontal {
    background-color: #0B0A12;
}

QProgressBar {
    background-color: #0B0A12;
    border: 1px solid #4B3A68;
    text-align: center;
    color: #F2EAFF;
}

QProgressBar::chunk {
    background-color: #A3D977;
}

QStatusBar,
QStatusBar QLabel {
    background-color: #0B0A12;
    border-top: 1px solid #4B3A68;
    color: #9A86B8;
}

QStatusBar::item {
    border-left: 1px solid #26233A;
    padding: 0 4px;
}

QDockWidget::title {
    background-color: #141218;
    border: 1px solid #4B3A68;
    padding: 4px 6px;
    text-align: left;
    color: #A3D977;
}

QSplitter::handle {
    background-color: #26233A;
}

QSplitter::handle:hover {
    background-color: #7C5FB8;
}

QTabWidget::pane {
    border: 1px solid #4B3A68;
}

QTabBar::tab {
    background-color: #141218;
    border: 1px solid #4B3A68;
    padding: 4px 8px;
    color: #9A86B8;
}

QTabBar::tab:selected {
    background-color: #4B3A68;
    border-color: #C4A7E7;
    color: #F7EFFF;
}

QTabBar::tab:hover {
    color: #C4A7E7;
}

QScrollBar:vertical {
    background-color: #0F1020;
    width: 9px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #4B3A68;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #7C5FB8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #0F1020;
    height: 9px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #4B3A68;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #7C5FB8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QToolTip,
QLabel#floating_control_time {
    background-color: #0B0A12;
    border: 1px solid #7C5FB8;
    color: #C4A7E7;
    padding: 3px 5px;
}

#time_label {
    color: #A3D977;
    border: none;
    font-weight: bold;
    padding-left: 8px;
    padding-right: 8px;
}
