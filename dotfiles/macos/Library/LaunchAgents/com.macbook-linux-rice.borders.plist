<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.macbook-linux-rice.borders</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/borders</string>
		<string>active_color=gradient(top_left=0xffa3d977,bottom_right=0xff6faf6e)</string>
		<string>inactive_color=0xff26233a</string>
		<string>width=6.0</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/tmp/macbook-linux-rice-borders.out.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/macbook-linux-rice-borders.err.log</string>
</dict>
</plist>
