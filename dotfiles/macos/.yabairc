#!/usr/bin/env sh

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# The scripting addition enables native-space operations and animation-related behavior,
# but it only loads after the documented partial SIP change has been made from Recovery.
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa >/tmp/yabai-load-sa.log 2>&1 || true"
sudo yabai --load-sa >/tmp/yabai-load-sa.log 2>&1 || true

yabai -m config \
  external_bar                 all:34:0 \
  menubar_opacity              0.0 \
  mouse_follows_focus          on \
  focus_follows_mouse          autofocus \
  display_arrangement_order    default \
  window_origin_display        focused \
  window_placement             second_child \
  window_insertion_point       focused \
  window_zoom_persist          on \
  window_shadow                on \
  skip_window_focus_animation  off \
  window_animation_duration    0.18 \
  window_animation_easing      ease_out_circ \
  window_opacity_duration      0.12 \
  active_window_opacity        1.0 \
  normal_window_opacity        0.96 \
  window_opacity               off \
  insert_feedback_color        0xff7c5fb8 \
  split_ratio                  0.50 \
  split_type                   auto \
  auto_balance                 off \
  top_padding                  2 \
  bottom_padding               10 \
  left_padding                 10 \
  right_padding                10 \
  window_gap                   10 \
  layout                       bsp \
  mouse_modifier               cmd \
  mouse_action1                move \
  mouse_action2                resize \
  mouse_drop_action            swap

yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add title="Preferences$" manage=off

yabai -m signal --add event=space_changed action="sketchybar --trigger yabai_space_change"
yabai -m signal --add event=display_changed action="sketchybar --trigger yabai_space_change"
yabai -m signal --add event=display_added action="$HOME/.local/bin/rice-display-route"
yabai -m signal --add event=display_removed action="$HOME/.local/bin/rice-display-route"
yabai -m signal --add event=display_changed action="$HOME/.local/bin/rice-display-route"
yabai -m signal --add event=window_focused action="sketchybar --trigger front_app_switched"

yabai -m signal --add event=dock_did_restart action="$HOME/.local/bin/rice-display-route"

"$HOME/.local/bin/rice-display-route"
sketchybar --trigger yabai_space_change

echo "yabai configuration loaded"
