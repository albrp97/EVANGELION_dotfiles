#!/usr/bin/env python3
import os
import re
import select
import signal
import subprocess
import sys
import termios
import time
import tty

PID_FILE = os.path.expanduser("~/.cache/macbook-linux-rice/power-dashboard.pid")
CAFFEINATE_PID_FILE = os.path.expanduser("~/.cache/macbook-linux-rice-caffeinate.pid")
REPO_DIR = os.path.expanduser("~/Documents/code/macbook-linux-rice")
FOCUS_SIGNAL = "rice_power_dashboard_focus_out"
DASHBOARD_COMMAND = os.path.expanduser("~/.local/bin/rice-power-dashboard")
ORIGIN_GRID = "12:12:0:0:2:1"
FINAL_GRID = "12:12:0:1:8:7"

RESET = "\033[0m"
BG = "\033[48;2;11;13;25m"
PURPLE = "\033[38;2;196;167;231m"
PURPLE_DIM = "\033[38;2;124;95;184m"
GREEN = "\033[38;2;163;217;119m"
GREEN_DIM = "\033[38;2;111;175;110m"
ORANGE = "\033[38;2;246;166;109m"
INVERT_GREEN = "\033[38;2;11;13;25m\033[48;2;163;217;119m"
INVERT_ORANGE = "\033[38;2;11;13;25m\033[48;2;246;166;109m"

WIDTH = 100
HEIGHT = 27

TILES = [
    ("L", "LOCK", "secure now", "lock", False),
    ("D", "DISPLAY", "panel off", "display", False),
    ("S", "SLEEP", "suspend mac", "sleep", False),
    ("C", "CAFFEINE", "30m toggle", "caffeinate", False),
    ("R", "RICE", "restart ui", "rice", False),
    ("O", "LOGOUT", "end session", "logout", True),
    ("B", "REBOOT", "restart mac", "restart", True),
    ("X", "POWER", "shutdown", "shutdown", True),
]


def run(command):
    return subprocess.run(command, text=True, capture_output=True, check=False).stdout.strip()


def command_ok(command):
    return subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False).returncode == 0


def shell(command):
    subprocess.Popen(
        ["/bin/zsh", "-lc", command],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def battery_status():
    raw = run(["pmset", "-g", "batt"])
    percent = re.search(r"(\d+)%", raw)
    remaining = re.search(r"(\d+:\d+)\s+remaining", raw)
    state = "charging" if "AC Power" in raw or "charging" in raw else "battery"
    return f"{percent.group(1) if percent else '--'}% :: {remaining.group(1) if remaining else '--'} :: {state}"


def brightness_status():
    raw = run(["ioreg", "-w0", "-l"])
    match = re.search(r'"brightness"=\{[^}]*"max"=([0-9]+)[^}]*"value"=([0-9]+)', raw, re.S)
    if not match:
        return "--%"
    maximum, value = int(match.group(1)), int(match.group(2))
    return f"{round(value / maximum * 100)}%" if maximum else "--%"


def volume_status():
    raw = run(["osascript", "-e", "output volume of (get volume settings)"])
    return f"{raw or '--'}%"


def uptime_status():
    raw = run(["sysctl", "-n", "kern.boottime"])
    match = re.search(r"sec = (\d+)", raw)
    if not match:
        return "--"
    seconds = int(time.time()) - int(match.group(1))
    hours = seconds // 3600
    minutes = (seconds % 3600) // 60
    return f"{hours // 24}d {hours % 24}h" if hours >= 24 else f"{hours}h {minutes}m"


def caffeinate_status():
    try:
        with open(CAFFEINATE_PID_FILE, "r", encoding="utf-8") as pid_file:
            pid = int(pid_file.read().strip())
        os.kill(pid, 0)
        return "active"
    except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
        return "ready"


def rice_status():
    alive = sum(1 for process in ("sketchybar", "yabai", "borders") if command_ok(["pgrep", "-qx", process]))
    return f"{alive}/3 services online"


def action_command(action):
    commands = {
        "lock": "/System/Library/CoreServices/Menu\\ Extras/User.menu/Contents/Resources/CGSession -suspend",
        "display": "pmset displaysleepnow",
        "sleep": "pmset sleepnow",
        "rice": f"{REPO_DIR}/scripts/start-services.sh",
        "logout": "osascript -e 'tell application \"System Events\" to log out'",
        "restart": "osascript -e 'tell application \"System Events\" to restart'",
        "shutdown": "osascript -e 'tell application \"System Events\" to shut down'",
    }
    if action == "caffeinate":
        return (
            'mkdir -p "$HOME/.cache"; '
            'pid_file="$HOME/.cache/macbook-linux-rice-caffeinate.pid"; '
            'if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then '
            'kill "$(cat "$pid_file")"; rm -f "$pid_file"; '
            'else caffeinate -dimsu -t 1800 >/tmp/macbook-linux-rice-caffeinate.log 2>&1 & echo "$!" > "$pid_file"; fi'
        )
    return commands[action]


def write_pid():
    os.makedirs(os.path.dirname(PID_FILE), exist_ok=True)
    with open(PID_FILE, "w", encoding="utf-8") as pid_file:
        pid_file.write(str(os.getpid()))


def apply_dashboard_window(grid, opacity):
    moved = command_ok(["yabai", "-m", "window", "--grid", grid])
    command_ok(["yabai", "-m", "window", "--sub-layer", "above"])
    command_ok(["yabai", "-m", "window", "--opacity", opacity])
    return moved


def animate_dashboard_window():
    apply_dashboard_window(ORIGIN_GRID, "0.72")
    time.sleep(0.18)
    apply_dashboard_window(FINAL_GRID, "1.0")
    deadline = time.time() + 1.2
    while time.time() < deadline:
        columns, lines = term_size()
        if columns >= WIDTH and lines >= HEIGHT:
            break
        time.sleep(0.05)
    time.sleep(0.12)


def install_focus_signal():
    command_ok(["yabai", "-m", "signal", "--remove", FOCUS_SIGNAL])
    command_ok([
        "yabai",
        "-m",
        "signal",
        "--add",
        f"label={FOCUS_SIGNAL}",
        "event=window_focused",
        'title!="^EVA-01 POWER DASH$"',
        f"action={DASHBOARD_COMMAND} close",
    ])


def cleanup(_signum=None, _frame=None):
    print("\033[?1000l\033[?1003l\033[?1006l\033[?25h\033[0m\033[2J\033[H", end="", flush=True)
    command_ok(["yabai", "-m", "signal", "--remove", FOCUS_SIGNAL])
    try:
        with open(PID_FILE, "r", encoding="utf-8") as pid_file:
            if pid_file.read().strip() == str(os.getpid()):
                os.remove(PID_FILE)
    except FileNotFoundError:
        pass
    if _signum is not None:
        raise SystemExit(0)


def term_size():
    size = os.get_terminal_size()
    return size.columns, size.lines


def origin():
    columns, lines = term_size()
    return max(1, (columns - WIDTH) // 2 + 1), 1


def move(x, y):
    return f"\033[{y};{x}H"


def write_at(x, y, text, color=PURPLE):
    print(f"{move(x, y)}{color}{text}{RESET}{BG}", end="")


def hline(x, y, width, color=PURPLE_DIM):
    write_at(x, y, "+" + "-" * (width - 2) + "+", color)


def box(x, y, width, height, title, color=PURPLE_DIM):
    hline(x, y, width, color)
    for row in range(1, height - 1):
        write_at(x, y + row, "|" + " " * (width - 2) + "|", color)
    hline(x, y + height - 1, width, color)
    if title:
        write_at(x + 3, y, f"[ {title} ]", GREEN)


def tile_rects(start_x, start_y):
    rects = {}
    tile_w = 22
    tile_h = 4
    gap = 1
    for index, tile in enumerate(TILES):
        row, col = divmod(index, 4)
        x = start_x + col * (tile_w + gap)
        y = start_y + row * (tile_h + 1)
        rects[tile[3]] = (x, y, tile_w, tile_h)
    return rects


def draw_tile(x, y, width, height, key, title, detail, action, danger, hover):
    color = ORANGE if danger else GREEN
    fill = INVERT_ORANGE if danger and hover else INVERT_GREEN if hover else BG
    border = color if hover else PURPLE_DIM
    print(fill, end="")
    box(x, y, width, height, "", border)
    write_at(x + 2, y + 1, f"[{key}] {title}".ljust(width - 4), color if hover else PURPLE)
    write_at(x + 2, y + 2, detail.ljust(width - 4), PURPLE_DIM if not hover else fill)
    print(BG, end="")


def draw(hover=None, armed=None):
    ox, oy = origin()
    print(f"{BG}\033[2J\033[H\033]0;EVA-01 POWER DASH\a\033[8;31;112t", end="")
    box(ox, oy, WIDTH, HEIGHT, "", GREEN_DIM)
    write_at(ox + 3, oy + 1, "EVA-01 POWER DASH", PURPLE)
    write_at(ox + 79, oy + 1, "mode::terminal", ORANGE)
    write_at(ox + 3, oy + 2, "AI CORE // POWER CONTROL // NO APPLE DIALOGS", GREEN)
    write_at(ox + 2, oy + 4, "-" * (WIDTH - 4), PURPLE_DIM)

    box(ox + 3, oy + 6, 46, 8, "core telemetry")
    statuses = [
        ("BAT", battery_status(), GREEN),
        ("BRT", brightness_status(), PURPLE),
        ("VOL", volume_status(), PURPLE),
        ("UP ", uptime_status(), PURPLE),
        ("CAF", caffeinate_status(), ORANGE if caffeinate_status() == "active" else PURPLE),
    ]
    for idx, (key, value, color) in enumerate(statuses):
        write_at(ox + 6, oy + 8 + idx, key, color)
        write_at(ox + 12, oy + 8 + idx, "::::", ORANGE)
        write_at(ox + 19, oy + 8 + idx, value[:27], PURPLE)

    box(ox + 51, oy + 6, 46, 8, "rice session")
    write_at(ox + 54, oy + 8, "WM  : yabai", GREEN)
    write_at(ox + 54, oy + 9, "BAR : sketchybar", PURPLE)
    write_at(ox + 54, oy + 10, f"SYS : {rice_status()}", PURPLE)
    write_at(ox + 54, oy + 11, "KEY : click tile or press letter", ORANGE)
    write_at(ox + 54, oy + 12, "ESC/Q : close  OUTSIDE : close", ORANGE)

    box(ox + 3, oy + 15, 94, 12, "command grid")
    rects = tile_rects(ox + 5, oy + 17)
    for key, title, detail, action, danger in TILES:
        x, y, width, height = rects[action]
        draw_tile(x, y, width, height, key, title, detail, action, danger, hover == action)

    if armed:
        x, y = ox + 30, oy + 8
        box(x, y, 44, 7, "confirm", ORANGE)
        write_at(x + 4, y + 2, f"confirm --{armed}", ORANGE)
        write_at(x + 4, y + 3, "destructive command armed", PURPLE)
        write_at(x + 4, y + 4, "enter/click executes, esc cancels", GREEN)

    print(RESET, end="", flush=True)
    return rects


def draw_boot():
    print(f"{BG}\033[2J\033[H\033]0;EVA-01 POWER DASH\a\033[8;9;32t", end="")
    box(1, 1, 30, 7, "power core", GREEN_DIM)
    write_at(4, 3, "EVA-01 boot", PURPLE)
    write_at(4, 4, "origin :: power", GREEN)
    write_at(4, 5, "expand :: dashboard", ORANGE)
    print(RESET, end="", flush=True)


def parse_mouse(buffer):
    match = re.search(r"\033\[<(\d+);(\d+);(\d+)([mM])", buffer)
    if not match:
        return None
    button, x, y, event = match.groups()
    button = int(button)
    if event != "M" or button not in (0, 32, 35):
        return None
    kind = "click" if button == 0 else "move"
    return kind, int(x), int(y)


def action_at(rects, x, y):
    for action, (rx, ry, width, height) in rects.items():
        if rx <= x < rx + width and ry <= y < ry + height:
            return action
    return None


def execute(action):
    cleanup()
    shell(action_command(action))
    raise SystemExit(0)


def animated_close():
    shell(f"{DASHBOARD_COMMAND} close")
    time.sleep(0.2)
    raise SystemExit(0)


def main():
    write_pid()
    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)
    old_term = termios.tcgetattr(sys.stdin)
    tty.setcbreak(sys.stdin.fileno())
    armed = None
    hover = None
    try:
        print("\033[?25l\033[?1000h\033[?1003h\033[?1006h", end="", flush=True)
        draw_boot()
        animate_dashboard_window()
        rects = draw(hover, armed)
        install_focus_signal()
        while True:
            ready, _, _ = select.select([sys.stdin], [], [], 0.2)
            if not ready:
                continue
            data = os.read(sys.stdin.fileno(), 64).decode("utf-8", "ignore")
            mouse = parse_mouse(data)
            if mouse:
                kind, mouse_x, mouse_y = mouse
                clicked = action_at(rects, mouse_x, mouse_y)
                if kind == "move":
                    if clicked != hover:
                        hover = clicked
                        rects = draw(hover, armed)
                    continue
                if armed:
                    if clicked == armed:
                        execute(armed)
                    armed = None
                elif clicked:
                    danger = next(tile[4] for tile in TILES if tile[3] == clicked)
                    if danger:
                        armed = clicked
                    elif clicked == "caffeinate":
                        shell(action_command(clicked))
                        time.sleep(0.3)
                    else:
                        execute(clicked)
                rects = draw(hover, armed)
                continue

            key = data.lower()
            if key in ("\x1b", "q"):
                if armed:
                    armed = None
                    rects = draw(hover, armed)
                    continue
                animated_close()
            if key in ("\r", "\n") and armed:
                execute(armed)
            for tile_key, _title, _detail, action, danger in TILES:
                if key == tile_key.lower():
                    if danger:
                        armed = action
                    elif action == "caffeinate":
                        shell(action_command(action))
                        time.sleep(0.3)
                    else:
                        execute(action)
                    rects = draw(hover, armed)
                    break
    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_term)
        cleanup()


if __name__ == "__main__":
    main()
