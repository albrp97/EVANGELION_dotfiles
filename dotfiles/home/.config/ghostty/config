font-family = Liga SFMono Nerd Font
font-size = 14
font-feature = -calt
font-feature = -liga
font-thicken = true
font-thicken-strength = 120

background = #0f1020
foreground = #f2eaff
selection-background = #7c5fb8
selection-foreground = #f7efff
cursor-color = #f6c177
cursor-text = #0f1020

palette = 0=#151126
palette = 1=#d98bc4
palette = 2=#a3d977
palette = 3=#f6c177
palette = 4=#9a86b8
palette = 5=#c4a7e7
palette = 6=#6faf6e
palette = 7=#f2eaff
palette = 8=#8f7bc4
palette = 9=#ebbcba
palette = 10=#d3f6a3
palette = 11=#f6c177
palette = 12=#a889e6
palette = 13=#b78cff
palette = 14=#b9a7d9
palette = 15=#ffffff

background-opacity = 0.70
background-opacity-cells = true
background-blur = 76
unfocused-split-opacity = 1
window-padding-x = 12
window-padding-y = 12

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,no-sudo,title,no-ssh-env,no-ssh-terminfo,path
custom-shader = ~/.config/ghostty/shaders/eva-cursor-trail.glsl
custom-shader-animation = true
mouse-hide-while-typing = true

macos-titlebar-style = hidden
macos-option-as-alt = true
confirm-close-surface = false
keybind = super+q=close_window
keybind = super+arrow_right=text:\x1b[1;9C
