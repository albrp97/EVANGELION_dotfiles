#!/usr/bin/env bash
set -euo pipefail

wallpaper_dir="${RICE_WALLPAPER_DIR:-/Users/ghiki/Documents/code/macbook-linux-rice/wallpapers}"
requested_wallpaper="${1:-}"

if [[ ! -d "$wallpaper_dir" ]]; then
  echo "Wallpaper directory does not exist: $wallpaper_dir" >&2
  exit 66
fi

if [[ -n "$requested_wallpaper" ]]; then
  if [[ ! -f "$requested_wallpaper" ]]; then
    echo "Requested wallpaper does not exist: $requested_wallpaper" >&2
    exit 66
  fi
  wallpaper="$requested_wallpaper"
else
  wallpaper="$(find "$wallpaper_dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.heic' \) | sort | /usr/bin/awk 'BEGIN { srand() } { files[++count] = $0 } END { if (count > 0) print files[int(rand() * count) + 1] }')"
fi

if [[ -z "$wallpaper" ]]; then
  echo "No wallpaper files found in: $wallpaper_dir" >&2
  exit 66
fi

/usr/bin/osascript <<APPLESCRIPT
tell application "System Events"
  repeat with currentDesktop in desktops
    set picture of currentDesktop to "$wallpaper"
  end repeat
end tell
APPLESCRIPT

mkdir -p "$HOME/.cache"
echo "$wallpaper" > "$HOME/.cache/macbook-linux-rice-current-wallpaper"

uid="$(id -u)"
launchctl kickstart -k "gui/$uid/com.apple.Dock.agent" >/dev/null 2>&1 || true
