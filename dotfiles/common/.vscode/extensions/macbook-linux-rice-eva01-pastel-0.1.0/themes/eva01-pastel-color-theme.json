  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9A86B8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#C4A7E7"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "entity.name.function.python"
      ],
      "settings": {
        "foreground": "#A3D977"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#9A86B8"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable.name",
        "support.variable"
      ],
      "settings": {
        "foreground": "#E0DEF4"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "markup.inline.raw.string"
      ],
      "settings": {
        "foreground": "#B48DDB"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character.escape",
        "support.constant"
      ],
      "settings": {
        "foreground": "#F6C177"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.type.property-name",
        "meta.object-literal.key",
        "meta.mapping.key",
        "string.json support.type.property-name"
      ],
      "settings": {
        "foreground": "#C4A7E7"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#C4C8D8"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#0F1020",
        "background": "#D98BC4"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#C4A7E7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F6C177",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#EBBCBA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#A3D977",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9A86B8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.list",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#A3D977"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#C4A7E7",
        "background": "#0F1020E6"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#9A86B8",
    "type": "#9A86B8",
    "class": "#9A86B8",
    "enum": "#9A86B8",
    "interface": "#9A86B8",
    "struct": "#9A86B8",
    "typeParameter": "#9A86B8",
    "function": "#A3D977",
    "method": "#A3D977",
    "macro": "#D98BC4",
    "variable": "#E0DEF4",
    "parameter": "#C4C8D8",
    "property": "#C4A7E7",
    "enumMember": "#F6C177",
    "event": "#D98BC4",
    "keyword": "#C4A7E7",
    "string": "#B48DDB",
    "number": "#F6C177",
    "regexp": "#6FAF6E",
    "operator": "#C4A7E7",
    "comment": {
      "foreground": "#9A86B8",
      "fontStyle": "italic"
    }
  }
}
