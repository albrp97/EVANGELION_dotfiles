# EVA-01 Pastel theme for btop

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#f2eaff"

# Title color for boxes
theme[title]="#c4a7e7"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#a3d977"

# Background color of selected item in processes box
theme[selected_bg]="#7c5fb8"

# Foreground color of selected item in processes box
theme[selected_fg]="#f7efff"

# Color of inactive/disabled text
theme[inactive_fg]="#9a86b8"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c4a7e7"

# Background color of the percentage meters
theme[meter_bg]="#26233a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#9a86b8"

# Cpu box outline color
theme[cpu_box]="#7c5fb8"

# Memory/disks box outline color
theme[mem_box]="#7c5fb8"

# Net up/down box outline color
theme[net_box]="#7c5fb8"

# Processes box outline color
theme[proc_box]="#7c5fb8"

# Box divider line and small boxes line color
theme[div_line]="#26233a"

# Temperature graph colors
theme[temp_start]="#a3d977"
theme[temp_mid]="#f6c177"
theme[temp_end]="#d98bc4"

# CPU graph colors
theme[cpu_start]="#a3d977"
theme[cpu_mid]="#6faf6e"
theme[cpu_end]="#d98bc4"

# Mem/Disk free meter
theme[free_start]="#d3f6a3"
theme[free_mid]="#a3d977"
theme[free_end]="#6faf6e"

# Mem/Disk cached meter
theme[cached_start]="#b78cff"
theme[cached_mid]="#c4a7e7"
theme[cached_end]="#8f7bc4"

# Mem/Disk available meter
theme[available_start]="#d8c7ff"
theme[available_mid]="#c4a7e7"
theme[available_end]="#8f7bc4"

# Mem/Disk used meter
theme[used_start]="#f6c177"
theme[used_mid]="#d99a5e"
theme[used_end]="#d98bc4"

# Download graph colors
theme[download_start]="#a3d977"
theme[download_mid]="#6faf6e"
theme[download_end]="#9a86b8"

# Upload graph colors
theme[upload_start]="#b78cff"
theme[upload_mid]="#c4a7e7"
theme[upload_end]="#d98bc4"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#b48ddb"
theme[process_mid]="#8f7bc4"
theme[process_end]="#7c5fb8"
