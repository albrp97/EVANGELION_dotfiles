{
  "title": "MacBook Rice v2 Command+Space Launcher Shortcuts",
  "rules": [
    {
      "description": "MacBook Rice v2: Command+Space launcher actions",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "3",
            "modifiers": {
              "mandatory": [
                "command",
                "shift"
              ],
              "optional": [
                "caps_lock",
                "fn"
              ]
            }
          },
          "to": [
            {
              "key_code": "3",
              "modifiers": [
                "left_command",
                "left_control",
                "left_option",
                "left_shift"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "spacebar",
            "modifiers": {
              "mandatory": [
                "command"
              ],
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "rice_v2_launcher",
                "value": 1
              }
            }
          ],
          "conditions": [
            {
              "type": "variable_unless",
              "name": "rice_v2_launcher",
              "value": 1
            }
          ],
          "to_delayed_action": {
            "to_if_invoked": [
              {
                "set_variable": {
                  "name": "rice_v2_launcher",
                  "value": 0
                }
              }
            ]
          },
          "parameters": {
            "basic.to_delayed_action_delay_milliseconds": 1500
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "spacebar",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "conditions": [
            {
              "type": "variable_if",
              "name": "rice_v2_launcher",
              "value": 1
            }
          ],
          "to": [
            {
              "shell_command": "/usr/bin/open -a Raycast"
            },
            {
              "set_variable": {
                "name": "rice_v2_launcher",
                "value": 0
              }
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "t",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "conditions": [
            {
              "type": "variable_if",
              "name": "rice_v2_launcher",
              "value": 1
            }
          ],
          "to": [
            {
              "shell_command": "/bin/bash -lc '$HOME/.local/bin/rice-v2-open-terminal'"
            },
            {
              "set_variable": {
                "name": "rice_v2_launcher",
                "value": 0
              }
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
