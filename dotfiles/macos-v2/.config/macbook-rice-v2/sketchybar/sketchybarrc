#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="$HOME/.config/macbook-rice-v2/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

PILL_GAP=6
PILL_EDGE=$((PILL_GAP / 2))

sketchybar --bar \
  position=top \
  height=34 \
  topmost=window \
  color="$BAR_BG" \
  blur_radius=0 \
  sticky=on \
  margin=0 \
  y_offset=0 \
  padding_left=14 \
  padding_right=14

sketchybar --default \
  icon.font="Liga SFMono Nerd Font:Bold:13.0" \
  icon.color="$TEXT" \
  label.font="Liga SFMono Nerd Font:Bold:12.0" \
  label.color="$TEXT" \
  background.color="$ITEM_BG" \
  background.corner_radius=12 \
  background.height=24 \
  background.padding_left=6 \
  background.padding_right=6 \
  padding_left="$PILL_EDGE" \
  padding_right="$PILL_EDGE"

sketchybar --add event aerospace_workspace_change

sketchybar --add item power left \
  --set power \
    icon="⏻" \
    icon.font="Liga SFMono Nerd Font:Bold:15.0" \
    icon.padding_left=7 \
    icon.padding_right=7 \
    label.drawing=off \
    script="$PLUGIN_DIR/power_item.sh" \
    click_script="$HOME/.local/bin/rice-v2-power-menu"

sketchybar --subscribe power mouse.entered mouse.exited

sketchybar --add item clock left \
  --set clock \
    icon.drawing=off \
    padding_right="$PILL_GAP" \
    label.padding_left=9 \
    label.padding_right=9 \
    update_freq=30 \
    script="$PLUGIN_DIR/clock.sh"

WORKSPACE_ITEMS=()
for sid in 1 2 3 4 5 6 7 8 9; do
  item="workspace.$sid"
  WORKSPACE_ITEMS+=("$item")
  sketchybar --add item "$item" left \
    --set "$item" \
      icon="●" \
      icon.font="Liga SFMono Nerd Font:Bold:16.0" \
      icon.padding_left=5 \
      icon.padding_right=5 \
      label.drawing=off \
      background.drawing=off \
      click_script="$HOME/.local/bin/rice-v2-workspace $sid" \
      script="$PLUGIN_DIR/aerospace_workspaces.sh" \
    --subscribe "$item" aerospace_workspace_change
done

sketchybar --add bracket spaces "${WORKSPACE_ITEMS[@]}" \
  --set spaces \
    position=left \
    background.color="$ITEM_BG" \
    background.corner_radius=12 \
    background.height=24 \
    background.padding_left=8 \
    background.padding_right=8

sketchybar --add item battery right \
  --set battery \
    icon.font="Liga SFMono Nerd Font:Bold:13.0" \
    icon.padding_left=7 \
    icon.padding_right=4 \
    label.padding_right=8 \
    update_freq=10 \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery power_source_change system_woke

sketchybar --add item weather right \
  --set weather \
    icon="☼" \
    padding_left=0 \
    icon.padding_left=7 \
    icon.padding_right=4 \
    label.padding_right=8 \
    update_freq=600 \
    script="$PLUGIN_DIR/weather.sh"

sketchybar --add item cpu right \
  --set cpu \
    icon.font="Liga SFMono Nerd Font:Bold:13.0" \
    icon.padding_left=0 \
    icon.padding_right=4 \
    label.font="Liga SFMono Nerd Font:Bold:12.0" \
    label.padding_left=2 \
    label.padding_right=2 \
    padding_right=5 \
    width=56 \
    background.drawing=off \
    update_freq=2 \
    script="$PLUGIN_DIR/system_usage.sh"

sketchybar --add item ram right \
  --set ram \
    icon.font="Liga SFMono Nerd Font:Bold:13.0" \
    icon.padding_left=5 \
    icon.padding_right=2 \
    label.font="Liga SFMono Nerd Font:Bold:12.0" \
    label.padding_left=2 \
    label.padding_right=2 \
    width=56 \
    background.drawing=off \
    update_freq=2 \
    script="$PLUGIN_DIR/system_usage.sh"

sketchybar --add item ssd right \
  --set ssd \
    icon.font="Liga SFMono Nerd Font:Bold:13.0" \
    icon.padding_left=5 \
    icon.padding_right=2 \
    label.font="Liga SFMono Nerd Font:Bold:12.0" \
    label.padding_left=2 \
    label.padding_right=2 \
    padding_right=5 \
    width=56 \
    background.drawing=off \
    update_freq=2 \
    script="$PLUGIN_DIR/system_usage.sh"

sketchybar --add item cpu_ram_gap right \
  --set cpu_ram_gap \
    width=2 \
    drawing=on \
    background.drawing=off \
    icon.drawing=off \
    label.drawing=off \
    padding_left=0 \
    padding_right=0

sketchybar --add item ram_ssd_gap right \
  --set ram_ssd_gap \
    width=6 \
    drawing=on \
    background.drawing=off \
    icon.drawing=off \
    label.drawing=off \
    padding_left=0 \
    padding_right=0

sketchybar --add item system_weather_gap right \
  --set system_weather_gap \
    width=6 \
    drawing=on \
    background.drawing=off \
    icon.drawing=off \
    label.drawing=off \
    padding_left=0 \
    padding_right=0

sketchybar --add bracket system_usage cpu cpu_ram_gap ram ram_ssd_gap ssd \
  --set system_usage \
    position=right \
    background.drawing=on \
    background.color="$ITEM_BG" \
    background.corner_radius=12 \
    background.height=24 \
    background.padding_left=15 \
    background.padding_right=15

sketchybar --move ssd after weather
sketchybar --move ram after ssd
sketchybar --move cpu after ram
sketchybar --move cpu_ram_gap after ram
sketchybar --move ram_ssd_gap after ssd
sketchybar --move system_weather_gap after weather

sketchybar --add item wallpaper_rotation left \
  --set wallpaper_rotation \
    drawing=off \
    update_freq=1800 \
    script="$PLUGIN_DIR/wallpaper_rotation.sh"

sketchybar --update
