#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.homebrew/bin:$HOME/.homebrew/sbin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

if ! command -v borders >/dev/null 2>&1; then
  echo "JankyBorders is missing. Run scripts/macos-v2/bootstrap-tools.sh." >&2
  exit 1
fi

exec borders \
  'active_color=gradient(top_left=0xffa3d977,bottom_right=0xff6faf6e)' \
  'inactive_color=0xff26233a' \
  'width=6.0'
